<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.13</Version>
    <AssemblyName>Nonuglon</AssemblyName>
    <RootNamespace>Nonuglon</RootNamespace>
    <Author>Nonu</Author>
    <Name>Nonuglon</Name>
    <InternalName>Nonuglon</InternalName>
    <Punchline>Nonu's personal grab-bag of tweaks.</Punchline>
    <Description>A handful of personal tweaks.</Description>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ECommons" Version="3.2.1.15" />
    <PackageReference Include="KamiToolKit" Version="2.2.55" />
  </ItemGroup>

  <!-- Dev plugins read their icon from images/icon.png next to the DLL;
       installed (repo) plugins use IconUrl from repo.json instead. -->
  <ItemGroup>
    <Content Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
